<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6">

  <!--
    Synthetic test graph for Vrstevnice routing integration tests.
    Generated by scripts/generate-test-graph.py

    Three interconnected paths from Start to End:
    Path A (direct, ~4.5 km): all tertiary — penalized by roadAvoid
    Path B (medium, ~5.0 km): all unclassified — NOT in any custom model rule (no penalty)
    Path C (long,  ~9.0 km): all cycleway — BOOSTED by cyclewayCoeff
    Cross-links at midpoints connect all three paths.
  -->

  <!-- ===== Nodes ===== -->
  <node id="1" lat="50.060000" lon="14.440000">
    <tag k="name" v="Start"/>
  </node>
  <node id="2" lat="50.100000" lon="14.440000">
    <tag k="name" v="End"/>
  </node>
  <node id="3" lat="50.068000" lon="14.441000">
    <tag k="name" v="A_Trunk"/>
    <tag k="highway" v="trunk"/>
  </node>
  <node id="4" lat="50.076000" lon="14.439000">
    <tag k="name" v="A_Primary"/>
    <tag k="highway" v="primary"/>
  </node>
  <node id="5" lat="50.084000" lon="14.441000">
    <tag k="name" v="A_Secondary"/>
    <tag k="highway" v="secondary"/>
  </node>
  <node id="6" lat="50.092000" lon="14.439000">
    <tag k="name" v="A_Tertiary"/>
    <tag k="highway" v="tertiary"/>
  </node>
  <node id="7" lat="50.068000" lon="14.451000">
    <tag k="name" v="B_Unc1"/>
    <tag k="highway" v="unclassified"/>
  </node>
  <node id="8" lat="50.076000" lon="14.449000">
    <tag k="name" v="B_Unc2"/>
    <tag k="highway" v="unclassified"/>
  </node>
  <node id="9" lat="50.084000" lon="14.451000">
    <tag k="name" v="B_Unc3"/>
    <tag k="highway" v="unclassified"/>
  </node>
  <node id="10" lat="50.092000" lon="14.449000">
    <tag k="name" v="B_Unc4"/>
    <tag k="highway" v="unclassified"/>
  </node>
  <node id="11" lat="50.068000" lon="14.481000">
    <tag k="name" v="C_Cyc1"/>
    <tag k="highway" v="cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </node>
  <node id="12" lat="50.076000" lon="14.479000">
    <tag k="name" v="C_Cyc2"/>
    <tag k="highway" v="cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </node>
  <node id="13" lat="50.084000" lon="14.481000">
    <tag k="name" v="C_Cyc3"/>
    <tag k="highway" v="cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </node>
  <node id="14" lat="50.092000" lon="14.479000">
    <tag k="name" v="C_Cyc4"/>
    <tag k="highway" v="cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </node>
  <!-- Exact-way isolation nodes must remain before every way for OSM import. -->
  <node id="100" lat="50.120000" lon="14.440000">
    <tag k="name" v="Exact_Start"/>
  </node>
  <node id="101" lat="50.124000" lon="14.440000">
    <tag k="name" v="Exact_Junction"/>
  </node>
  <node id="102" lat="50.124800" lon="14.440000">
    <tag k="name" v="Exact_TargetEnd"/>
  </node>
  <node id="103" lat="50.132000" lon="14.440000">
    <tag k="name" v="Exact_End"/>
  </node>
  <node id="104" lat="50.124000" lon="14.440700">
    <tag k="name" v="Exact_Parallel1"/>
  </node>
  <node id="105" lat="50.128000" lon="14.440700">
    <tag k="name" v="Exact_Parallel2"/>
  </node>

  <!-- ===== Ways ===== -->
  <way id="15">
    <nd ref="1"/>
    <nd ref="3"/>
    <tag k="highway" v="tertiary"/>
    <tag k="name" v="A_tertiary"/>
  </way>
  <way id="16">
    <nd ref="3"/>
    <nd ref="4"/>
    <tag k="highway" v="tertiary"/>
