  </way>
  <way id="32">
    <nd ref="6"/>
    <nd ref="10"/>
    <tag k="highway" v="unclassified"/>
    <tag k="name" v="X_AB_3"/>
  </way>
  <way id="33">
    <nd ref="10"/>
    <nd ref="14"/>
    <tag k="highway" v="unclassified"/>
    <tag k="name" v="X_BC_3"/>
  </way>

  <!-- ===== Exact-way isolation fixture =====
       Two deliberately close, parallel alternatives.  They meet at Junction;
       1001 is a short, independently-rated middle segment on the direct branch.
       Penalizing it must leave the common approach and the neighbouring branch
       usable rather than buffering/penalizing the entire junction. -->
  <way id="1000"><nd ref="100"/><nd ref="101"/><tag k="highway" v="unclassified"/><tag k="name" v="Shared approach"/></way>
  <way id="1001"><nd ref="101"/><nd ref="102"/><tag k="highway" v="unclassified"/><tag k="name" v="Short rated segment"/></way>
  <way id="1002"><nd ref="102"/><nd ref="103"/><tag k="highway" v="unclassified"/><tag k="name" v="Direct continuation"/></way>
  <way id="1010"><nd ref="101"/><nd ref="104"/><tag k="highway" v="unclassified"/><tag k="name" v="Close parallel"/></way>
  <way id="1011"><nd ref="104"/><nd ref="105"/><tag k="highway" v="unclassified"/><tag k="name" v="Close parallel"/></way>
  <way id="1012"><nd ref="105"/><nd ref="103"/><tag k="highway" v="unclassified"/><tag k="name" v="Close parallel"/></way>

</osm>
