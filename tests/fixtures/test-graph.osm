  </way>
  <way id="25">
    <nd ref="1"/>
    <nd ref="11"/>
    <tag k="highway" v="cycleway"/>
    <tag k="name" v="C_cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </way>
  <way id="26">
    <nd ref="11"/>
    <nd ref="12"/>
    <tag k="highway" v="cycleway"/>
    <tag k="name" v="C_cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </way>
  <way id="27">
    <nd ref="12"/>
    <nd ref="13"/>
    <tag k="highway" v="cycleway"/>
    <tag k="name" v="C_cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </way>
  <way id="28">
    <nd ref="13"/>
    <nd ref="14"/>
    <tag k="highway" v="cycleway"/>
    <tag k="name" v="C_cycleway"/>
    <tag k="surface" v="paving_stones"/>
  </way>
  <way id="29">
    <nd ref="14"/>
