<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6">

  <!--
    Synthetic test graph for Vrstevnice routing integration tests.
    Generated by scripts/generate-test-graph.py

    Three interconnected paths from Start to End:
    Path A (direct, ~4.5 km): all tertiary — penalized by roadAvoid
    Path B (medium, ~5.0 km): all unclassified — NOT in any custom model rule (no penalty)
    Path C (long,  ~9.0 km): all cycleway — BOOSTED by cyclewayCoeff
    Cross-links at midpoints connect all three paths.
  -->

  <!-- ===== Nodes ===== -->
  <node id="1" lat="50.060000" lon="14.440000">
    <tag k="name" v="Start"/>
  </node>
  <node id="2" lat="50.100000" lon="14.440000">
