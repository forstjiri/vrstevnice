{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@vrstevnice/shared": ["src/shared/index.ts"],
      "@vrstevnice/routing": ["src/routing/index.ts"],
      "@vrstevnice/be": ["src/be/index.ts"],
      "@vrstevnice/fe": ["src/fe/App.tsx"],
      "@vrstevnice/fe/*": ["src/fe/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src", "tests"]
}
